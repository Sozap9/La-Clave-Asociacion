# ================================================================
# LA CLAVE - BACKEND API
# Configuración de Variables de Entorno
# ================================================================
# IMPORTANTE: 
# 1. Copia este archivo como .env en la raíz del proyecto
# 2. Reemplaza los valores de ejemplo con los valores reales
# 3. NUNCA subas el archivo .env a Git (está en .gitignore)
# ================================================================

# ================================================================
# 🚀 SERVER CONFIGURATION
# ================================================================
# Puerto en el que correrá el servidor
PORT=5000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# ================================================================
# 🗄️ DATABASE CONFIGURATION
# ================================================================
# Host de la base de datos MySQL
DB_HOST=localhost

# Usuario de la base de datos
DB_USER=root

# Contraseña del usuario de la base de datos
DB_PASSWORD=your_secure_password_here

# Nombre de la base de datos
DB_NAME=la_clave

# Puerto de MySQL (por defecto: 3306)
DB_PORT=3306

# ================================================================
# 🔐 JWT CONFIGURATION
# ================================================================
# IMPORTANTE: Genera secrets seguros con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Secret para firmar Access Tokens (mínimo 32 caracteres)
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_recommended_64

# Tiempo de expiración del Access Token
# Ejemplos: 15m (15 minutos), 1h (1 hora), 7d (7 días)
JWT_EXPIRE=7d

# Secret para firmar Refresh Tokens (debe ser diferente a JWT_SECRET)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_minimum_32_characters_recommended_64

# Tiempo de expiración del Refresh Token
# Recomendado: mayor que JWT_EXPIRE
JWT_REFRESH_EXPIRE=30d

# ================================================================
# 💳 STRIPE CONFIGURATION
# ================================================================
# IMPORTANTE: Usa claves de TEST en development y claves LIVE en production

# Secret Key de Stripe (sk_test_... en test, sk_live_... en production)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Publishable Key de Stripe (pk_test_... en test, pk_live_... en production)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Webhook Secret de Stripe (whsec_...)
# Obtén este valor al crear el webhook endpoint en Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ID del Price de la suscripción mensual en Stripe
# Obtén este valor desde Stripe Dashboard > Products
STRIPE_PRICE_ID=price_your_price_id_here

# ================================================================
# 📧 EMAIL CONFIGURATION
# ================================================================
# Servidor SMTP para envío de emails

# Host del servidor SMTP
# Gmail: smtp.gmail.com
# Outlook: smtp-mail.outlook.com
# SendGrid: smtp.sendgrid.net
EMAIL_HOST=smtp.gmail.com

# Puerto SMTP
# Gmail: 587 (TLS) o 465 (SSL)
# SendGrid: 587
EMAIL_PORT=587

# Usar conexión segura (true para SSL, false para TLS)
EMAIL_SECURE=false

# Usuario del servidor SMTP (generalmente tu email)
EMAIL_USER=your_email@gmail.com

# Contraseña del servidor SMTP
# Gmail: Usa una "App Password" (no tu contraseña de Gmail)
# https://support.google.com/accounts/answer/185833
EMAIL_PASS=your_email_password_or_app_password

# Email y nombre que aparecerá como remitente
EMAIL_FROM=La Clave <noreply@laclave.com>

# ================================================================
# 🌐 URL CONFIGURATION
# ================================================================
# URL del frontend (donde corre React/Vue/etc)
# Development: http://localhost:3006
# Production: https://laclave.com
FRONTEND_URL=http://localhost:3006

# URL del backend (donde corre este API)
# Development: http://localhost:5000
# Production: https://api.laclave.com
BACKEND_URL=http://localhost:5000

# ================================================================
# 📁 UPLOAD CONFIGURATION
# ================================================================
# Tamaño máximo de archivos en bytes
# 5MB = 5242880 bytes
# 10MB = 10485760 bytes
MAX_FILE_SIZE=5242880

# Carpeta donde se guardarán los archivos subidos
# Ruta relativa desde la raíz del proyecto
UPLOAD_PATH=./uploads

# Extensiones de imagen permitidas (separadas por coma)
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp

# Extensiones de documento permitidas (separadas por coma)
ALLOWED_DOC_EXTENSIONS=pdf,doc,docx

# ================================================================
# 📊 BUSINESS RULES
# ================================================================
# Número máximo de socios permitidos en el sistema
MAX_SOCIOS=1000

# Capacidad máxima por defecto para eventos
MAX_ENTRADAS_POR_EVENTO=300

# Cuota mensual de socio (en euros)
# IMPORTANTE: Este valor debe coincidir con el precio en Stripe
CUOTA_MENSUAL_SOCIO=10.00

# Edad mínima para registrarse como socio
EDAD_MINIMA=18

# Días de gracia antes de marcar a un socio como moroso
DIAS_GRACIA_PAGO=7

# Número máximo de entradas que un socio puede reservar por evento
MAX_RESERVAS_POR_SOCIO=4

# ================================================================
# 🏢 SITE INFORMATION
# ================================================================
# Nombre del sitio/negocio
SITE_NAME=La Clave

# Email de contacto principal
SITE_EMAIL=info@laclave.com

# Teléfono de contacto
SITE_PHONE=+34600000000

# Dirección física (opcional)
SITE_ADDRESS=Calle Ejemplo 123, Madrid, España

# ================================================================
# 🔒 SECURITY CONFIGURATION (Opcional)
# ================================================================
# Activar HTTPS estricto en producción
# FORCE_HTTPS=true

# Dominios permitidos para CORS (separados por coma)
# Si no se especifica, se usa FRONTEND_URL por defecto
# CORS_ORIGINS=https://laclave.com,https://www.laclave.com

# ================================================================
# 📝 LOGGING CONFIGURATION
# ================================================================
# Nivel de logs: error | warn | info | http | debug
# Producción: warn | Desarrollo: debug
LOG_LEVEL=info

# Carpeta donde se guardarán los archivos de log
LOG_PATH=./logs

# Número máximo de días para conservar logs antiguos
# combined logs: 14 días
# error logs: 30 días
# http logs: 7 días
LOG_RETENTION_DAYS=30

# ================================================================
# 🐛 DEBUG CONFIGURATION (Opcional)
# ================================================================
# Mostrar lista de endpoints al iniciar el servidor
# true = mostrar | false = ocultar (recomendado en producción)
DEBUG=false

# ================================================================
# 🚨 MONITORING (Opcional - para producción)
# ================================================================
# Sentry DSN para monitoreo de errores
# SENTRY_DSN=https://your_sentry_dsn_here

# New Relic License Key para monitoreo de rendimiento
# NEW_RELIC_LICENSE_KEY=your_new_relic_key_here

# ================================================================
# 🧪 TESTING (Opcional - para CI/CD)
# ================================================================
# Variables específicas para tests
# TEST_DB_NAME=la_clave_test
# TEST_JWT_SECRET=test_jwt_secret_key